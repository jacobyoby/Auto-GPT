{
  "attribution": {
    "commit": "",
    "sessionUrl": false
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cd \"${CLAUDE_PROJECT_DIR:-.}\" && { [ -f .git/hooks/commit-msg ] || cp .githooks/commit-msg .git/hooks/commit-msg; }"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/commit-guard.py"
          }
        ]
      }
    ]
  }
}
